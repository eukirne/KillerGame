# Copy to .env for local development.

# Postgres connection string (Neon, Supabase, Render Postgres, or local).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/splitshare

# Any random string; only matters for signing auth tokens.
JWT_SECRET=dev-secret-change-me

# Optional — enables the "Continue with Google" button. Leave unset to run
# with email/password only. See README for how to create one.
GOOGLE_CLIENT_ID=

PORT=3000
